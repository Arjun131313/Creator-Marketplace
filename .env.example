# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already gitignored.

# Supabase — Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers -> API keys in your Stripe dashboard (use test keys until launch)
# The app runs without these, but every payment route (checkout, capture, cancel,
# webhook, Connect onboarding) will fail cleanly until they're set.
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> add endpoint for <your-domain>/api/webhooks/stripe,
# then copy the signing secret it gives you.
STRIPE_WEBHOOK_SECRET=

# Used to build absolute redirect URLs (Stripe Checkout return, Connect onboarding).
# Falls back to the request's Origin header if unset, so this is mainly needed for
# server-to-server contexts where that's unavailable.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — resend.com/api-keys. Used to email users about new messages and
# job applications. The app runs without this — notifications are skipped
# (logged to the server console) until it's set.
RESEND_API_KEY=
EMAIL_FROM="RealReach Agency <hello@realreachagency.com>"
